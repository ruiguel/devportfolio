# Copia este ficheiro para ".env" e preenche com os teus valores.
# NUNCA envies o ficheiro ".env" real para o repositório (já está no .gitignore).

# Vai a https://app.turso.tech -> a tua base de dados -> "Connect"
# para obteres estes dois valores.
DATABASE_URL=libsql://o-teu-database.turso.io
DATABASE_AUTH_TOKEN=o-teu-token-aqui

# Qualquer texto secreto suficientemente longo/aleatório.
JWT_SECRET=escolhe-um-segredo-longo-e-aleatorio-aqui

# Opcional: credenciais da conta do formador (usadas apenas por
# server/db/seed.js). Se não definires, são usados os valores
# documentados no README.md.
FORMADOR_EMAIL=formador@formador.com
FORMADOR_PASSWORD=Formador_2026Belem

PORT=3000
